{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ghawi-app",
  // worker.ts wraps OpenNext's .open-next/worker.js (live theme switch).
  "main": "worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  "services": [
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "ghawi-app"
    }
  ],

  // Incremental cache for Next.js. Omit the bucket name until you create one:
  //   wrangler r2 bucket create ghawi-app-cache
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "ghawi-app-cache"
    },
    // Wedding photos for invite.ghawi.app (Admin → Invitation → Photos):
    //   wrangler r2 bucket create ghawi-invite-photos
    {
      "binding": "INVITE_PHOTOS",
      "bucket_name": "ghawi-invite-photos"
    }
  ],

  // Contact form submissions. Created automatically on first deploy, or manually:
  //   wrangler d1 create ghawi-app-contacts
  "d1_databases": [
    {
      "binding": "CONTACT_DB",
      "database_name": "ghawi-app-contacts",
      "database_id": "68a92480-1f3d-45e7-be19-47a0dd5b3781",
      "migrations_dir": "./migrations"
    }
  ],

  // Transactional email for contact form notifications.
  // Onboard the sending domain first:
  //   wrangler email sending enable ghawi.app
  "send_email": [
    {
      "name": "EMAIL"
    }
  ],

  "images": {
    "binding": "IMAGES"
  },

  // Each deploy's id: worker.ts keys its edge cache of rendered pages on it,
  // so a deploy never serves pages from the one before.
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },

  "vars": {
    "CONTACT_TO_EMAIL": "ahmedghuwu3@gmail.com",
    "ADMIN_USERNAME": "ahmedgh",
    "CONTACT_FROM_EMAIL": "contact@ghawi.app",
    // Public by design — Turnstile site keys are meant to be client-visible.
    // The matching secret lives in Workers Secrets, never in this file.
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFWI655DLJFx_2zZ",
    // boti.ghawi.app manages this repo's client branches. Its token is the
    // GITHUB_TOKEN secret (fine-grained, this repo only).
    "BOTI_REPO": "GH-ZX/boti"
  },
"routes": [
  { "pattern": "ghawi.app", "custom_domain": true },
  { "pattern": "www.ghawi.app", "custom_domain": true },
  // The wedding invitation (next.config.ts rewrites it onto /invite).
  { "pattern": "invite.ghawi.app", "custom_domain": true },
  // The CV and its builder (next.config.ts rewrites it onto /resume).
  { "pattern": "cv.ghawi.app", "custom_domain": true },
  // boti, the Plus Store X client panel (next.config.ts rewrites it onto /boti).
  { "pattern": "boti.ghawi.app", "custom_domain": true }
],

  "observability": {
    "enabled": true
  }
}